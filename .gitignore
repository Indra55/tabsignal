# Local Chrome Web Store drafts and generated assets.
/store/

# Keep only the nested, Vercel-ready privacy policy site.
/website/*
!/website/privacy-policy/
/website/privacy-policy/*
!/website/privacy-policy/index.html

# Generated promo material. Keep only the README meme images.
/promo/*
!/promo/readme/
/promo/readme/*
!/promo/readme/*.jpg
